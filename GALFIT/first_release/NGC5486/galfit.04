# IMAGE and GALFIT CONTROL PARAMETERS
A) F814W_img_drc-smooth.fits[1]      # Input data image (FITS file)
B) NGC5486_F814W_fit.fits      # Output data image block
C) F814W_img_drc-rms.fits[1]      # Sigma image name (made from data if blank or "none") 
D) 211d51m15.40512s+55d06m10.51992s_F814W_psf_drc_crop.fits[1]          # Input PSF image and (optional) diffusion kernel
E) 1                   # PSF fine sampling factor relative to data 
F) F814W_img_drc_mask-smooth.fits[1]      # Bad pixel mask (FITS image or ASCII coord list)
G) none                # File with parameter constraints (ASCII file) 
H) 600  3600 900  3900 # Image region to fit (xmin xmax ymin ymax)
I) 3000   3000         # Size of the convolution box (x y)
J) 25.933              # Magnitude photometric zeropoint 
K) 0.050  0.050        # Plate scale (dx dy)   [arcsec per pixel]
O) regular             # Display type (regular, curses, both)
P) 0                   # Choose: 0=optimize, 1=model, 2=imgblock, 3=subcomps

# INITIAL FITTING PARAMETERS
