B) UGC5427_F814W_fit.fits      # Output data image block
C) F814W_img_drc-rms.fits[1]      # Sigma image name (made from data if blank or "none") 
D) 151d10m14.2356s+29d21m51.5448s_F814W_psf_drc_crop.fits[1]          # Input PSF image and (optional) diffusion kernel
